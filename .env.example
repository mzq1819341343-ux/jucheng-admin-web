# === Supabase 配置（占位示例，真值只填在本地 .env.local 与 Vercel 环境变量里，绝不提交） ===
# Supabase 控制台 → Project Settings → API 可查
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 仅服务端使用（切勿加 NEXT_PUBLIC_ 前缀、切勿出现在前端代码里）
# 员工草案 Route 用它直写 salary_realtime_draft。不要放进 NEXT_PUBLIC_。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-server-only

# 员工草案占位 / 底薪同步的独立闸。默认关。与灌数闸 ALLOW_APPLY_REALTIME_DRAFT 无关。
# 仅服务端 Route 读取。生产开闸须后端独立闸就绪，且另有产品令。不要在仓库里写成 true。
ALLOW_EMPLOYEE_DRAFT_WRITE=false
